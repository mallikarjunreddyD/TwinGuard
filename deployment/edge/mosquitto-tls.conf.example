# For a reviewed LAN only: externally provision certificate CNs equal registered source identities.
listener 8883
allow_anonymous false
cafile /run/secrets/ca.crt
certfile /run/secrets/broker.crt
keyfile /run/secrets/broker.key
require_certificate true
use_identity_as_username true
acl_file /mosquitto/config/acl
persistence true
persistence_location /mosquitto/data/
max_packet_size 131072
