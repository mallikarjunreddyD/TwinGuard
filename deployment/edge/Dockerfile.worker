# Dependency layers precede source copies so ordinary code edits do not reinstall Open3D.
FROM python:3.12-slim
WORKDIR /app
COPY requirements-edge.lock requirements-analytics.lock ./
RUN pip install --no-cache-dir -r requirements-edge.lock -r requirements-analytics.lock
COPY src/twinguard/__init__.py src/twinguard/__init__.py
COPY src/twinguard/core src/twinguard/core
RUN rm -f src/twinguard/core/config.py src/twinguard/core/registry.py
COPY src/twinguard/analytics src/twinguard/analytics
COPY src/twinguard/fusion src/twinguard/fusion
COPY src/twinguard/edge src/twinguard/edge
COPY configs/fusion configs/fusion
COPY configs/analytics configs/analytics
COPY configs/edge configs/edge
ENV PYTHONPATH=/app/src TWINGUARD_ROOT=/app OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
RUN useradd -m -u 10001 twinguard
USER twinguard
CMD ["python","-m","twinguard.edge.worker","inspection"]
