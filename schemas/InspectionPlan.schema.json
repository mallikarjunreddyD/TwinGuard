{
  "$defs": {
    "AssetInspectionPriority": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "terms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Terms",
          "type": "object"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "access": {
          "enum": [
            "review_required",
            "restricted",
            "recommended"
          ],
          "title": "Access",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "score",
        "terms",
        "reasons",
        "access"
      ],
      "title": "AssetInspectionPriority",
      "type": "object"
    },
    "CandidateViewpoint": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "viewpoint_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Viewpoint Id",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "intended_region": {
          "title": "Intended Region",
          "type": "string"
        },
        "modality": {
          "enum": [
            "lidar",
            "thermal"
          ],
          "title": "Modality",
          "type": "string"
        },
        "planned_pose": {
          "$ref": "#/$defs/Transform"
        },
        "coordinate_frame": {
          "default": "plant-01",
          "title": "Coordinate Frame",
          "type": "string"
        },
        "sensor_reference": {
          "title": "Sensor Reference",
          "type": "string"
        },
        "calibration_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calibration Reference"
        },
        "expected_range_m": {
          "minimum": 0,
          "title": "Expected Range M",
          "type": "number"
        },
        "incidence_cosine_mean": {
          "maximum": 1,
          "minimum": 0,
          "title": "Incidence Cosine Mean",
          "type": "number"
        },
        "predicted_visible_cells": {
          "items": {
            "type": "integer"
          },
          "title": "Predicted Visible Cells",
          "type": "array"
        },
        "predicted_usable_cells": {
          "items": {
            "type": "integer"
          },
          "title": "Predicted Usable Cells",
          "type": "array"
        },
        "expected_usable_area_m2": {
          "minimum": 0,
          "title": "Expected Usable Area M2",
          "type": "number"
        },
        "predicted_spacing_m": {
          "minimum": 0,
          "title": "Predicted Spacing M",
          "type": "number"
        },
        "expected_quality": {
          "maximum": 1,
          "minimum": 0,
          "title": "Expected Quality",
          "type": "number"
        },
        "registration_support_returns": {
          "minimum": 0,
          "title": "Registration Support Returns",
          "type": "integer"
        },
        "acquisition_s": {
          "exclusiveMinimum": 0,
          "title": "Acquisition S",
          "type": "number"
        },
        "feasibility": {
          "$ref": "#/$defs/ViewpointFeasibility"
        },
        "utility": {
          "$ref": "#/$defs/ViewpointUtility"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "viewpoint_id",
        "asset_id",
        "intended_region",
        "modality",
        "planned_pose",
        "sensor_reference",
        "calibration_reference",
        "expected_range_m",
        "incidence_cosine_mean",
        "predicted_visible_cells",
        "predicted_usable_cells",
        "expected_usable_area_m2",
        "predicted_spacing_m",
        "expected_quality",
        "registration_support_returns",
        "acquisition_s",
        "feasibility",
        "assumptions"
      ],
      "title": "CandidateViewpoint",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "world",
            "asset_local",
            "sensor_local",
            "registered_world"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference_id": {
          "title": "Reference Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference_id"
      ],
      "title": "Frame",
      "type": "object"
    },
    "InspectionPlanStep": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "viewpoint_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Viewpoint Id",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "travel_m": {
          "minimum": 0,
          "title": "Travel M",
          "type": "number"
        },
        "travel_s": {
          "minimum": 0,
          "title": "Travel S",
          "type": "number"
        },
        "acquisition_s": {
          "exclusiveMinimum": 0,
          "title": "Acquisition S",
          "type": "number"
        },
        "marginal_area_m2": {
          "minimum": 0,
          "title": "Marginal Area M2",
          "type": "number"
        },
        "utility": {
          "$ref": "#/$defs/ViewpointUtility"
        }
      },
      "required": [
        "order",
        "viewpoint_id",
        "asset_id",
        "travel_m",
        "travel_s",
        "acquisition_s",
        "marginal_area_m2",
        "utility"
      ],
      "title": "InspectionPlanStep",
      "type": "object"
    },
    "InspectionPlanningRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "method": {
          "default": "P3",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            "P3v2"
          ],
          "title": "Method",
          "type": "string"
        },
        "budget_views": {
          "default": 4,
          "maximum": 12,
          "minimum": 1,
          "title": "Budget Views",
          "type": "integer"
        },
        "budget_s": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Budget S",
          "type": "number"
        },
        "maximum_travel_m": {
          "default": 50,
          "exclusiveMinimum": 0,
          "title": "Maximum Travel M",
          "type": "number"
        },
        "per_asset_limit": {
          "default": 4,
          "maximum": 12,
          "minimum": 1,
          "title": "Per Asset Limit",
          "type": "integer"
        },
        "previous_plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Plan Id"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "InspectionPlanningRequest",
      "type": "object"
    },
    "PlanningExplanation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected": {
          "items": {
            "type": "string"
          },
          "title": "Selected",
          "type": "array"
        },
        "rejected": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rejected",
          "type": "object"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "recommended_actions": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Actions",
          "type": "array"
        }
      },
      "required": [
        "selected",
        "rejected",
        "limitations",
        "recommended_actions"
      ],
      "title": "PlanningExplanation",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Frame"
        },
        "target": {
          "$ref": "#/$defs/Frame"
        },
        "matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        }
      },
      "required": [
        "source",
        "target",
        "matrix"
      ],
      "title": "Transform",
      "type": "object"
    },
    "ViewpointFeasibility": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "feasible",
            "infeasible",
            "requires_route_review"
          ],
          "title": "Status",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "operator_review_required": {
          "default": true,
          "title": "Operator Review Required",
          "type": "boolean"
        }
      },
      "required": [
        "status"
      ],
      "title": "ViewpointFeasibility",
      "type": "object"
    },
    "ViewpointUtility": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Score",
          "type": "number"
        },
        "terms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Terms",
          "type": "object"
        },
        "new_cells": {
          "items": {
            "type": "integer"
          },
          "title": "New Cells",
          "type": "array"
        }
      },
      "title": "ViewpointUtility",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Plan Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "snapshot_hash": {
      "title": "Snapshot Hash",
      "type": "string"
    },
    "policy_hash": {
      "title": "Policy Hash",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/InspectionPlanningRequest"
    },
    "priorities": {
      "items": {
        "$ref": "#/$defs/AssetInspectionPriority"
      },
      "title": "Priorities",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateViewpoint"
      },
      "title": "Candidates",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/InspectionPlanStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "estimated_duration_s": {
      "minimum": 0,
      "title": "Estimated Duration S",
      "type": "number"
    },
    "estimated_travel_m": {
      "minimum": 0,
      "title": "Estimated Travel M",
      "type": "number"
    },
    "expected_new_usable_area_m2": {
      "minimum": 0,
      "title": "Expected New Usable Area M2",
      "type": "number"
    },
    "expected_deficiency_reduction": {
      "maximum": 1,
      "minimum": 0,
      "title": "Expected Deficiency Reduction",
      "type": "number"
    },
    "targeted_assets": {
      "items": {
        "type": "string"
      },
      "title": "Targeted Assets",
      "type": "array"
    },
    "relevant_advisories": {
      "items": {
        "type": "string"
      },
      "title": "Relevant Advisories",
      "type": "array"
    },
    "status": {
      "enum": [
        "recommended",
        "no_viable_viewpoint",
        "continue_monitoring",
        "requires_route_review"
      ],
      "title": "Status",
      "type": "string"
    },
    "approval_status": {
      "const": "pending_operator_review",
      "default": "pending_operator_review",
      "title": "Approval Status",
      "type": "string"
    },
    "explanation": {
      "$ref": "#/$defs/PlanningExplanation"
    },
    "optimization_runtime_s": {
      "minimum": 0,
      "title": "Optimization Runtime S",
      "type": "number"
    },
    "previous_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Plan Id"
    }
  },
  "required": [
    "plan_id",
    "at",
    "snapshot_hash",
    "policy_hash",
    "request",
    "priorities",
    "candidates",
    "steps",
    "estimated_duration_s",
    "estimated_travel_m",
    "expected_new_usable_area_m2",
    "expected_deficiency_reduction",
    "targeted_assets",
    "relevant_advisories",
    "status",
    "explanation",
    "optimization_runtime_s"
  ],
  "title": "InspectionPlan",
  "type": "object"
}
