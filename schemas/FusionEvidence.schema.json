  "required": [
    "evidence_id",
    "source_id",
    "modality",
    "algorithm",
    "algorithm_version",
    "provenance_id",
    "asset_id",
    "acquired_at",
    "received_at",
    "available_at",
    "processed_at",
    "availability_basis",
    "clock_quality",
    "hypothesis",
    "finding",
    "scope",
    "measurement_basis",
    "qualification_status",
    "association",
    "origin_identity",
    "dependence_group",
    "quality",
    "coverage_status"
