      },
      "title": "Triggered Hazards",
      "type": "array"
    },
    "positive_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Positive Ids",
      "type": "array"
    },
    "historical_positive_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Historical Positive Ids",
      "type": "array"
    },
    "negative_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Negative Ids",
      "type": "array"
    },
    "missing_requirements": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Missing Requirements",
      "type": "array"
    },
    "rejected_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Rejected Ids",
      "type": "array"
    },
    "temporal": {
      "items": {
        "$ref": "#/$defs/TemporalDecision"
      },
      "title": "Temporal",
      "type": "array"
    },
    "compatibility": {
      "items": {
        "$ref": "#/$defs/CompatibilityDecision"
      },
      "title": "Compatibility",
      "type": "array"
    },
    "rationale": {
      "items": {
        "type": "string"
      },
      "title": "Rationale",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "event_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Event Ids",
      "type": "array"
    },
    "replay_mode": {
      "enum": [
        "online",
        "retrospective"
      ],
      "title": "Replay Mode",
      "type": "string"
    },
    "software_version": {
      "title": "Software Version",
      "type": "string"
    }
  },
  "required": [
    "assessment",
    "method",
    "policy_sha256",
    "triggered_hazards",
    "positive_ids",
    "negative_ids",
    "missing_requirements",
    "rejected_ids",
    "temporal",
    "compatibility",
    "rationale",
    "conflicts",
    "event_ids",
    "replay_mode",
    "software_version"
  ],
  "title": "DecisionTrace",
  "type": "object"
}
