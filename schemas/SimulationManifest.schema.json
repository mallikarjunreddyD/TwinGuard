{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "media_type"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "DatasetProvenance": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "dataset_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Dataset Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "synthetic",
            "public_real_world",
            "hybrid",
            "physical_experimental"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "real_source_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Real Source Ids",
          "type": "array"
        },
        "synthetic_transformations": {
          "items": {
            "type": "string"
          },
          "title": "Synthetic Transformations",
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "dataset_id",
        "source_type",
        "description"
      ],
      "title": "DatasetProvenance",
      "type": "object"
    },
    "RunArtifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "media_type",
        "size_bytes"
      ],
      "title": "RunArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Scenario Version",
      "type": "string"
    },
    "random_seed": {
      "minimum": 0,
      "title": "Random Seed",
      "type": "integer"
    },
    "software_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Software Version",
      "type": "string"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Git Commit"
    },
    "working_tree_dirty": {
      "title": "Working Tree Dirty",
      "type": "boolean"
    },
    "configuration_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Configuration Version",
      "type": "string"
    },
    "model_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Model Version",
      "type": "string"
    },
    "configuration_reference": {
      "title": "Configuration Reference",
      "type": "string"
    },
    "controller_configuration_reference": {
      "title": "Controller Configuration Reference",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/DatasetProvenance"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "generation_runtime_s": {
      "minimum": 0,
      "title": "Generation Runtime S",
      "type": "number"
    },
    "snapshot_times_s": {
      "items": {
        "type": "number"
      },
      "title": "Snapshot Times S",
      "type": "array"
    },
    "artifact_class": {
      "const": "simulation physical state; not sensor observations or analytics output",
      "title": "Artifact Class",
      "type": "string"
    },
    "source_tree_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Tree Sha256"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/RunArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "scenario_version",
    "random_seed",
    "software_version",
    "git_commit",
    "working_tree_dirty",
    "configuration_version",
    "model_version",
    "configuration_reference",
    "controller_configuration_reference",
    "provenance",
    "started_at",
    "ended_at",
    "generation_runtime_s",
    "snapshot_times_s",
    "artifact_class",
    "artifacts"
  ],
  "title": "SimulationManifest",
  "type": "object"
}
