{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "media_type"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "DatasetProvenance": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "dataset_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Dataset Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "synthetic",
            "public_real_world",
            "hybrid",
            "physical_experimental"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "real_source_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Real Source Ids",
          "type": "array"
        },
        "synthetic_transformations": {
          "items": {
            "type": "string"
          },
          "title": "Synthetic Transformations",
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "dataset_id",
        "source_type",
        "description"
      ],
      "title": "DatasetProvenance",
      "type": "object"
    },
    "ObservationReference": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "observation_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Observation Id",
          "type": "string"
        },
        "record_uri": {
          "title": "Record Uri",
          "type": "string"
        },
        "kind": {
          "enum": [
            "InspectionCapture",
            "SensorObservation"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "record_uri",
        "kind"
      ],
      "title": "ObservationReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "manifest_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Manifest Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetProvenance"
    },
    "software_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Software Version",
      "type": "string"
    },
    "configuration_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Configuration Version",
      "type": "string"
    },
    "master_seed": {
      "minimum": 0,
      "title": "Master Seed",
      "type": "integer"
    },
    "acquisition_namespace": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Acquisition Namespace",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ObservationReference"
      },
      "title": "Observations",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "manifest_id",
    "run_id",
    "dataset",
    "software_version",
    "configuration_version",
    "master_seed",
    "acquisition_namespace",
    "observations",
    "artifacts"
  ],
  "title": "ObservationManifest",
  "type": "object"
}
