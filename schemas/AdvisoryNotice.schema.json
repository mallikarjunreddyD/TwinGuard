{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "notice_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Notice Id",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Asset Id",
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "transition": {
      "title": "Transition",
      "type": "string"
    },
    "action": {
      "title": "Action",
      "type": "string"
    },
    "transport_status": {
      "const": "record_only",
      "default": "record_only",
      "title": "Transport Status",
      "type": "string"
    }
  },
  "required": [
    "notice_id",
    "event_id",
    "asset_id",
    "at",
    "transition",
    "action"
  ],
  "title": "AdvisoryNotice",
  "type": "object"
}
