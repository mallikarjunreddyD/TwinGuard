{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "action_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Action Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Asset Id",
      "type": "string"
    },
    "hazard_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hazard Id"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "kind": {
      "enum": [
        "acknowledge",
        "repair",
        "resolve"
      ],
      "title": "Kind",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "action_id",
    "asset_id",
    "at",
    "kind",
    "rationale"
  ],
  "title": "OperatorAction",
  "type": "object"
}
