{
  "$defs": {
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "world",
            "asset_local",
            "sensor_local",
            "registered_world"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference_id": {
          "title": "Reference Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference_id"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Frame"
        },
        "target": {
          "$ref": "#/$defs/Frame"
        },
        "matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        }
      },
      "required": [
        "source",
        "target",
        "matrix"
      ],
      "title": "Transform",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sensor_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Sensor Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Asset Id",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "synthetic",
        "public_real_world",
        "hybrid",
        "physical_experimental"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "configuration_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Configuration Version",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "modality": {
      "anyOf": [
        {
          "enum": [
            "lidar",
            "thermal",
            "rgb",
            "iot"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modality"
    },
    "coordinate_frame": {
      "anyOf": [
        {
          "$ref": "#/$defs/Frame"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pose": {
      "anyOf": [
        {
          "$ref": "#/$defs/Transform"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "acquisition_parameters": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Acquisition Parameters",
      "type": "object"
    },
    "calibration_reference": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration Reference"
    },
    "noise_model_reference": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Noise Model Reference"
    },
    "measurement_configuration": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Measurement Configuration",
      "type": "object"
    }
  },
  "required": [
    "sensor_id",
    "asset_id",
    "source_type",
    "configuration_version",
    "description"
  ],
  "title": "SensorConfiguration",
  "type": "object"
}
