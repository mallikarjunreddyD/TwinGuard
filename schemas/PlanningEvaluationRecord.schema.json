{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trial_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Trial Id",
      "type": "string"
    },
    "method": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P3v2"
      ],
      "title": "Method",
      "type": "string"
    },
    "partition": {
      "enum": [
        "development",
        "heldout"
      ],
      "title": "Partition",
      "type": "string"
    },
    "plan_hash": {
      "title": "Plan Hash",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Metrics",
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "trial_id",
    "method",
    "partition",
    "plan_hash",
    "metrics",
    "limitations"
  ],
  "title": "PlanningEvaluationRecord",
  "type": "object"
}
