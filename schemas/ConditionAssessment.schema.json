{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Asset Id",
      "type": "string"
    },
    "assessed_at": {
      "format": "date-time",
      "title": "Assessed At",
      "type": "string"
    },
    "severity": {
      "enum": [
        "green",
        "amber",
        "red",
        "unknown"
      ],
      "title": "Severity",
      "type": "string"
    },
    "confidence_status": {
      "enum": [
        "supported",
        "limited",
        "insufficient",
        "unknown"
      ],
      "title": "Confidence Status",
      "type": "string"
    },
    "supporting_evidence_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
    },
    "missing_or_invalid_evidence_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Missing Or Invalid Evidence Ids",
      "type": "array"
    },
    "recommended_action": {
      "title": "Recommended Action",
      "type": "string"
    },
    "policy_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Policy Version",
      "type": "string"
    },
    "human_review": {
      "enum": [
        "pending",
        "reviewed",
        "not_required"
      ],
      "title": "Human Review",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "assessed_at",
    "severity",
    "confidence_status",
    "supporting_evidence_ids",
    "missing_or_invalid_evidence_ids",
    "recommended_action",
    "policy_id",
    "policy_version",
    "human_review"
  ],
  "title": "ConditionAssessment",
  "type": "object"
}
